{
  "name": "terrain-emotes",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Terrain — catalogue local d'emotes GTA V & FiveM (rpemotes-reborn + scully_emotemenu)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0 --open",
